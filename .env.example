GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
KHAI_DEFAULT_CONNECTION=openrouter
KHAI_DEFAULT_MODEL=openai/gpt-6-luna
# Document search (RAG) embeddings, served through the OpenRouter connection.
# KHAI_RAG_EMBEDDING_MODEL=openai/text-embedding-3-small

# Spend limits in US dollars, per user (both off when empty).
# Cost comes from what OpenRouter reports for each response, otherwise the
# model catalog's list price; a model with neither is not counted.
# Turn limit: one message's whole run (all model calls and tool rounds). When
# the next model call would start over the limit, the turn stops with a clear
# message and is shown as completed.
# KHAI_MAX_TURN_COST_USD=0.50
# Session limit: running total for one chat. It is kept in memory, so it
# restarts from zero when the session runtime restarts (e.g. worker restart).
# KHAI_MAX_SESSION_COST_USD=5
