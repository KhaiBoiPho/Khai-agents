---
// The DeepCode landing page. Hand-crafted single file by design: a framed
// blueprint column — hairline rails, crosshair joints, one dark grey world —
// with the product window as the only thing that floats. The teaching guides
// live under /guide/.
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
const guides = `${base}guide/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="DeepCode — open agentic coding with a durable session record, one live writer per session, and measured context discipline."
    />
    <meta name="theme-color" content="#0b0c0e" />
    <title>DeepCode</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✳</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap">
    <style is:global>
  /* DeepCode — a blueprint sheet. Graphite ground, hairline rules, and a
     single steel-blue accent reserved for the things that are alive (the
     caret, the active plan step, focus). Depth comes from shadow, not color:
     only the product window and the code sheet lift off the page. */
  :root{
    color-scheme:dark;
    --bg:#0b0c0e;
    --bg-1:#101114;
    --bg-2:#15161a;
    --bg-3:#1b1c21;
    --ink:#ececee;
    --ink-2:#a3a5ab;
    --ink-3:#6c6f76;
    --ink-4:#45474d;
    --line:rgba(255,255,255,.075);
    --line-2:rgba(255,255,255,.13);
    --accent:#8aa8ff;
    --ok:#7fc79a;
    --grid:rgba(255,255,255,.028);
    --lift:
      0 0 0 1px rgba(0,0,0,.55),
      0 1px 0 0 rgba(255,255,255,.05) inset,
      0 2px 4px rgba(0,0,0,.35),
      0 24px 48px -12px rgba(0,0,0,.7),
      0 60px 120px -30px rgba(0,0,0,.65);
    --lift-sm:
      0 0 0 1px rgba(0,0,0,.5),
      0 1px 0 0 rgba(255,255,255,.05) inset,
      0 8px 20px -6px rgba(0,0,0,.6);
    --sans:"Geist",-apple-system,"Segoe UI","PingFang SC","Hiragino Sans GB",sans-serif;
    --mono:"Geist Mono",ui-monospace,"SF Mono",Menlo,Consolas,monospace;
    --w:1160px;
    --pad:clamp(1.25rem,4vw,3rem);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:var(--sans);
    font-size:15px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  ::selection{background:rgba(138,168,255,.28)}
  a{color:inherit;text-decoration:none}
  a:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:3px}
  code{font-family:var(--mono);font-size:.86em}

  /* ── the sheet: one framed column, rails top to bottom ─────────────── */
  .sheet{
    position:relative;
    max-width:var(--w);margin:0 auto;min-height:100vh;
    border-inline:1px solid var(--line);
  }
  .band{position:relative;border-top:1px solid var(--line)}
  .band.hero{border-top:0}
  .in{padding:clamp(3.5rem,8vw,6rem) var(--pad)}

  /* Crosshair joints where a band's rule meets the rails. */
  .band::before,.band::after{
    content:"";position:absolute;top:-5px;width:9px;height:9px;z-index:3;
    background:
      linear-gradient(var(--ink-3),var(--ink-3)) center/1px 100% no-repeat,
      linear-gradient(var(--ink-3),var(--ink-3)) center/100% 1px no-repeat;
  }
  .band::before{left:-5px}
  .band::after{right:-5px}
  .band.no-x::before,.band.no-x::after{display:none}

  /* ── top bar ────────────────────────────────────────────────────────── */
  header.top{
    position:sticky;top:0;z-index:20;
    background:rgba(11,12,14,.78);
    -webkit-backdrop-filter:blur(12px) saturate(140%);
    backdrop-filter:blur(12px) saturate(140%);
    border-bottom:1px solid var(--line);
  }
  header.top .bar{
    max-width:var(--w);margin:0 auto;height:56px;
    display:flex;align-items:center;gap:2rem;
    padding:0 var(--pad);border-inline:1px solid var(--line);
  }
  .brand{display:flex;align-items:center;gap:.55rem;font-weight:600;font-size:.98rem;letter-spacing:-.01em}
  .brand .mark{
    display:grid;place-items:center;width:22px;height:22px;border-radius:5px;
    background:var(--bg-3);box-shadow:var(--lift-sm);font-size:.8rem;color:var(--ink);
  }
  nav.links{display:flex;gap:1.5rem;font-size:.86rem}
  nav.links a{color:var(--ink-3);transition:color .15s}
  nav.links a:hover{color:var(--ink)}
  .top .end{margin-left:auto;display:flex;align-items:center;gap:.6rem}
  @media (max-width:760px){nav.links{display:none}}

  .btn{
    display:inline-flex;align-items:center;gap:.5rem;height:34px;padding:0 .9rem;
    border-radius:7px;font-size:.86rem;font-weight:500;white-space:nowrap;
    transition:background .15s,color .15s,box-shadow .15s,transform .15s;
  }
  .btn.solid{background:var(--ink);color:#0b0c0e;box-shadow:0 1px 0 rgba(255,255,255,.4) inset,0 6px 16px -6px rgba(0,0,0,.8)}
  .btn.solid:hover{background:#fff;transform:translateY(-1px)}
  .btn.ghost{background:var(--bg-2);color:var(--ink-2);box-shadow:var(--lift-sm)}
  .btn.ghost:hover{color:var(--ink);background:var(--bg-3)}
  .btn .k{font-family:var(--mono);font-size:.74rem;color:var(--ink-3)}

  /* ── hero ───────────────────────────────────────────────────────────── */
  .hero{position:relative;overflow:hidden}
  .hero .grid-bg{
    position:absolute;inset:0;pointer-events:none;
    background-image:
      linear-gradient(var(--grid) 1px,transparent 1px),
      linear-gradient(90deg,var(--grid) 1px,transparent 1px);
    background-size:32px 32px;background-position:-1px -1px;
    -webkit-mask-image:radial-gradient(ellipse 70% 80% at 50% 0%,#000 30%,transparent 75%);
    mask-image:radial-gradient(ellipse 70% 80% at 50% 0%,#000 30%,transparent 75%);
  }
  .hero .in{position:relative;padding-top:clamp(4.5rem,11vw,8rem);padding-bottom:clamp(3rem,6vw,4.5rem)}
  .label{
    display:inline-flex;align-items:center;gap:.55rem;
    font-family:var(--mono);font-size:.74rem;letter-spacing:.06em;
    text-transform:uppercase;color:var(--ink-3);
  }
  .label::before{content:"";width:6px;height:6px;background:var(--ink-4);box-shadow:0 0 0 1px var(--line-2)}
  .label.live::before{background:var(--accent);box-shadow:0 0 0 3px rgba(138,168,255,.14)}
  h1{
    margin:1.4rem 0 0;max-width:15ch;
    font-weight:500;font-size:clamp(2.6rem,6.4vw,4.75rem);
    line-height:1.02;letter-spacing:-.045em;text-wrap:balance;
  }
  h1 .dim{color:var(--ink-3)}
  .lede{margin:1.5rem 0 2.2rem;max-width:36rem;color:var(--ink-2);font-size:1.06rem;line-height:1.65}
  .ctas{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem}
  .install{
    display:inline-flex;align-items:center;height:42px;
    font-family:var(--mono);font-size:.86rem;
    background:var(--bg-2);border-radius:8px;box-shadow:var(--lift-sm);
  }
  .install .cmd{padding:0 1rem;color:var(--ink)}
  .install .cmd i{font-style:normal;color:var(--ink-3);margin-right:.6rem}
  .install button{
    all:unset;cursor:pointer;height:100%;padding:0 .9rem;
    border-left:1px solid var(--line);color:var(--ink-3);font-size:.76rem;
    transition:color .15s;
  }
  .install button:hover{color:var(--ink)}
  .ctas .btn{height:42px;padding:0 1.1rem}

  /* ── the product window: the one thing that floats ──────────────────── */
  .stage{position:relative;padding:0 var(--pad) clamp(3.5rem,8vw,6rem)}
  .win{
    position:relative;z-index:1;
    background:var(--bg-1);border-radius:12px;overflow:hidden;
    box-shadow:var(--lift);
    font-family:var(--mono);font-size:.8rem;line-height:1.7;
  }
  .win .title{
    display:grid;grid-template-columns:1fr auto 1fr;align-items:center;
    height:38px;padding:0 .9rem;
    background:var(--bg-2);border-bottom:1px solid rgba(0,0,0,.6);
    box-shadow:0 1px 0 var(--line) ;
    color:var(--ink-3);font-size:.72rem;
  }
  .win .dots{display:flex;gap:7px}
  .win .dots i{width:11px;height:11px;border-radius:50%;background:var(--bg-3);box-shadow:inset 0 0 0 1px var(--line-2)}
  .win .title .r{justify-self:end;display:flex;gap:1rem}
  .win .body{display:grid;grid-template-columns:220px minmax(0,1fr);min-height:27rem}
  @media (max-width:760px){.win .body{grid-template-columns:1fr}.win .side{display:none}}
  .win .side{
    background:var(--bg);border-right:1px solid var(--line);
    padding:.9rem 0;color:var(--ink-3);
  }
  .win .side h4{
    font-weight:400;font-size:.68rem;letter-spacing:.06em;text-transform:uppercase;
    color:var(--ink-4);padding:0 1rem;margin:0 0 .4rem;
  }
  .win .side h4:not(:first-child){margin-top:1.2rem}
  .win .side div{padding:.18rem 1rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .win .side .on{background:var(--bg-3);color:var(--ink);box-shadow:inset 2px 0 0 var(--accent)}
  .win .side .m{color:var(--ink-4)}
  .win .screen{padding:1.1rem 1.4rem 1.3rem}
  .win .status{
    display:flex;gap:1.4rem;padding:.4rem 1rem;
    border-top:1px solid var(--line);background:var(--bg-2);
    color:var(--ink-3);font-size:.7rem;
  }
  .win .status .ok{color:var(--ok)}
  .win .status .push{margin-left:auto}

  .row{white-space:pre-wrap;word-break:break-word;opacity:0;transform:translateY(2px)}
  .row.on{opacity:1;transform:none;transition:opacity .18s ease,transform .18s ease}
  .t-dim{color:var(--ink-3)}
  .t-user{color:var(--ink)}
  .t-user::before{content:"› ";color:var(--ink-3)}
  .t-tool .b{color:var(--ink-3)}
  .t-tool .n{color:var(--ink);font-weight:500}
  .t-tool .s{color:var(--ink-3)}
  .t-elbow{color:var(--ink-3)}
  .t-elbow .ok,.t-plan .ok{color:var(--ok)}
  .t-plan .done{color:var(--ink-3)}
  .t-plan .act{color:var(--accent)}
  .t-text{color:var(--ink-2)}
  .t-foot{color:var(--ink-4)}
  .caret{display:inline-block;width:.55em;height:1.1em;vertical-align:-.18em;background:var(--accent);animation:blink 1.1s steps(1) infinite}
  @keyframes blink{50%{opacity:0}}
  @media (prefers-reduced-motion:reduce){
    .row{opacity:1;transform:none;transition:none}
    .caret{animation:none}
  }

  /* ── section heads ──────────────────────────────────────────────────── */
  .head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1.5rem 4rem;align-items:end;margin-bottom:3rem}
  @media (max-width:860px){.head{grid-template-columns:1fr}}
  h2{
    margin-top:1rem;font-weight:500;letter-spacing:-.035em;line-height:1.1;
    font-size:clamp(1.7rem,3.4vw,2.5rem);text-wrap:balance;
  }
  h2 .dim{color:var(--ink-3)}
  .head p{color:var(--ink-2);max-width:32rem}

  /* Ruled tables: cells share hairlines, the sheet shows through. */
  .ruled{
    display:grid;gap:1px;background:var(--line);
    border-block:1px solid var(--line);
    margin-inline:calc(var(--pad) * -1);
  }
  .ruled > *{background:var(--bg);padding:2rem var(--pad)}
  .cols-4{grid-template-columns:repeat(4,minmax(0,1fr))}
  .cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}
  @media (max-width:980px){.cols-4{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:620px){.cols-4,.cols-2{grid-template-columns:1fr}}

  .cell{transition:background .2s}
  .cell:hover{background:var(--bg-1)}
  .cell .tag{font-family:var(--mono);font-size:.72rem;color:var(--ink-3)}
  .cell h3{margin:1.4rem 0 .5rem;font-weight:500;font-size:1.02rem;letter-spacing:-.01em}
  .cell p{font-size:.9rem;color:var(--ink-2)}
  .cell code{display:inline-block;margin-top:1rem;color:var(--ink-2);background:var(--bg-2);padding:.2rem .5rem;border-radius:5px;box-shadow:var(--lift-sm)}

  .stat .n{
    font-weight:500;letter-spacing:-.04em;line-height:1.05;
    font-size:clamp(1.9rem,3.6vw,2.6rem);font-variant-numeric:tabular-nums;
  }
  .stat .n .dim{color:var(--ink-3)}
  .stat .cap{margin-top:.75rem;font-family:var(--mono);font-size:.72rem;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-3)}
  .stat p{margin-top:.9rem;font-size:.9rem;color:var(--ink-2);max-width:30rem}
  .note{margin-top:2rem;font-size:.86rem;color:var(--ink-3);max-width:46rem}

  /* Definition list: name on the left, what it does on the right. */
  .defs{border-top:1px solid var(--line)}
  .def{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:.5rem 3rem;padding:1.6rem 0;border-bottom:1px solid var(--line)}
  @media (max-width:720px){.def{grid-template-columns:1fr}}
  .def h3{font-weight:500;font-size:1rem;letter-spacing:-.01em;display:flex;align-items:center;gap:.6rem}
  .def p{color:var(--ink-2);font-size:.94rem;max-width:40rem}
  .def code{color:var(--ink)}
  .soon{
    font-family:var(--mono);font-size:.64rem;font-weight:400;letter-spacing:.06em;text-transform:uppercase;
    color:var(--ink-3);border:1px solid var(--line-2);border-radius:4px;padding:.05rem .4rem;
  }

  /* Quickstart: the code sheet is the second lifted surface. */
  .qs-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:2.5rem 4rem;align-items:start}
  @media (max-width:860px){.qs-grid{grid-template-columns:1fr}}
  .qs-grid p{color:var(--ink-2);margin-top:1rem;max-width:26rem}
  .qs-grid .btn{margin-top:1.8rem}
  .sheetcode{border-radius:10px;overflow:hidden;background:var(--bg-1);box-shadow:var(--lift)}
  .sheetcode .title{
    display:flex;justify-content:space-between;padding:.6rem 1rem;
    background:var(--bg-2);border-bottom:1px solid rgba(0,0,0,.6);
    font-family:var(--mono);font-size:.72rem;color:var(--ink-3);
  }
  .sheetcode pre{padding:1.2rem 1.3rem 1.4rem;font-family:var(--mono);font-size:.85rem;line-height:1.85;overflow-x:auto}
  .sheetcode .c{color:var(--ink-3)}
  .sheetcode .p{color:var(--ink-4)}

  /* footer */
  footer .in{display:flex;flex-wrap:wrap;gap:2rem;justify-content:space-between;align-items:flex-start;padding-top:2.5rem;padding-bottom:3rem}
  footer p{font-size:.84rem;color:var(--ink-3);margin-top:.6rem;max-width:30rem}
  footer p a{color:var(--ink-2)}
  footer p a:hover{color:var(--ink)}
  footer nav{display:flex;gap:1.5rem;font-size:.86rem}
  footer nav a{color:var(--ink-3)}
  footer nav a:hover{color:var(--ink)}

  /* scroll reveal */
  .rv{opacity:0;transform:translateY(10px);transition:opacity .5s ease,transform .5s ease}
  .rv.in-view{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}}
</style>
  </head>
  <body>

<header class="top">
  <div class="bar">
    <a class="brand" href="#"><span class="mark" aria-hidden="true">✳</span> DeepCode</a>
    <nav class="links" aria-label="Site">
      <a href="#surfaces">Surfaces</a>
      <a href="#runtime">Runtime</a>
      <a href="#learns">Skills</a>
      <a href={guides}>Guides</a>
    </nav>
    <div class="end">
      <a class="btn ghost" href="https://github.com/HKUDS/DeepCode">GitHub</a>
      <a class="btn solid" href="#start">Install</a>
    </div>
  </div>
</header>

<main class="sheet">

  <section class="band hero no-x">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="in">
      <span class="label live">HKUDS · open source · model-agnostic</span>
      <h1>Open agentic coding, <span class="dim">on your machine.</span></h1>
      <p class="lede">
        A coding agent that lives where you work — a terminal-native TUI, a
        desktop app, and a headless CLI over one shared runtime. Your
        sessions, skills, and memory stay local.
      </p>
      <div class="ctas">
        <span class="install">
          <span class="cmd"><i>$</i>pip install deepcode-hku</span>
          <button type="button" data-copy="pip install deepcode-hku">Copy</button>
        </span>
        <a class="btn ghost" href={guides}>Read the guides <span class="k">→</span></a>
      </div>
    </div>
    <div class="stage">
      <div class="win" aria-label="DeepCode terminal session replay">
        <div class="title" aria-hidden="true">
          <span class="dots"><i></i><i></i><i></i></span>
          <span>deepcode — ~/proj/app</span>
          <span class="r"><span>main</span></span>
        </div>
        <div class="body">
          <div class="side" aria-hidden="true">
            <h4>Sessions</h4>
            <div class="on">fix failing auth test</div>
            <div>migrate settings schema</div>
            <div>profile cold start</div>
            <div class="m">tidy release notes</div>
            <h4>Skills</h4>
            <div>release-checklist</div>
            <div>pytest-triage</div>
            <h4>Memory</h4>
            <div>AGENTS.md</div>
            <div class="m">.deepcode/memory/</div>
          </div>
          <div class="screen" id="replay">
            <div class="row t-dim">deepseek/deepseek-v4-pro · ~/proj/app</div>
            <div class="row">&nbsp;</div>
            <div class="row t-user">fix the failing auth test, then run the suite</div>
            <div class="row">&nbsp;</div>
            <div class="row t-tool"><span class="b">●</span> <span class="n">Read</span> <span class="s">tests/test_auth.py</span></div>
            <div class="row t-elbow">  ⎿ <span class="ok">✓</span> 1: import pytest</div>
            <div class="row t-tool"><span class="b">●</span> <span class="n">Plan</span> <span class="s">1/3</span></div>
            <div class="row t-plan">  ⎿ <span class="ok">✓</span> <span class="done">reproduce the failure</span></div>
            <div class="row t-plan">    <span class="act">▸ patch the token-expiry check</span></div>
            <div class="row t-plan">    <span class="done">◦ run the full suite</span></div>
            <div class="row t-tool"><span class="b">●</span> <span class="n">Edit</span> <span class="s">src/auth/session.py</span></div>
            <div class="row t-elbow">  ⎿ <span class="ok">✓</span> session.py  +4 −2</div>
            <div class="row t-tool"><span class="b">●</span> <span class="n">Run</span> <span class="s">pytest -q</span></div>
            <div class="row t-elbow">  ⎿ <span class="ok">✓</span> 214 passed in 8.3s</div>
            <div class="row">&nbsp;</div>
            <div class="row t-text">The expiry check compared naive and aware datetimes; normalized both to UTC.</div>
            <div class="row t-foot">· 41s · 38.2k in · 512 out</div>
            <div class="row t-user"><span class="caret" aria-hidden="true"></span></div>
          </div>
        </div>
        <div class="status" aria-hidden="true">
          <span class="ok">● ready</span>
          <span>context 18%</span>
          <span class="push">1 live writer</span>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="surfaces">
    <div class="in">
      <div class="head rv">
        <div>
          <span class="label">Surfaces</span>
          <h2>Every surface reads <span class="dim">the same session.</span></h2>
        </div>
        <p>Start a conversation in the terminal over lunch, open it in the
        desktop app in the afternoon. Sessions, skills, permissions, and
        history are one shared record — not four copies.</p>
      </div>
      <div class="ruled cols-4 rv">
        <div class="cell">
          <span class="tag">cli.tui</span>
          <h3>Terminal</h3>
          <p>Streaming tool cards, a live status line, plan checklists, and a
          settled-turn footer with real token costs. Works over SSH.</p>
          <code>python -m cli.tui</code>
        </div>
        <div class="cell">
          <span class="tag">desktop</span>
          <h3>Desktop</h3>
          <p>A Tauri app over the same runtime: threads, approvals, skills,
          automations, and settings — with the session IDs the CLI uses.</p>
        </div>
        <div class="cell">
          <span class="tag">exec</span>
          <h3>Headless</h3>
          <p>One-shot execution that streams structured events for scripts
          and CI.</p>
          <code>deepcode exec --json</code>
        </div>
        <div class="cell">
          <span class="tag">mcp · goals</span>
          <h3>MCP &amp; automations</h3>
          <p>Expose DeepCode as an MCP server, schedule goal-driven runs, and
          let a goal loop work an objective against a real test command.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="runtime">
    <div class="in">
      <div class="head rv">
        <div>
          <span class="label">Runtime</span>
          <h2>Context is a discipline, <span class="dim">not an accident.</span></h2>
        </div>
        <p>The request is derived from the session record — append-only,
        reconstructable, and priced by what the provider actually reports.
        These numbers are from the changelog, not the brochure.</p>
      </div>
      <div class="ruled cols-2 rv">
        <div class="cell stat">
          <div class="n">7,420 <span class="dim">→ 28</span></div>
          <div class="cap">prompt tokens recomputed per turn boundary</div>
          <p>The environment block is a durable slot in history, so a new turn
          extends the previous request instead of invalidating its prefix
          cache.</p>
        </div>
        <div class="cell stat">
          <div class="n">1 <span class="dim">live writer</span></div>
          <div class="cap">per session · enforced by an OS lock</div>
          <p>Two windows on one session alternate safely; a mid-turn collision
          gets a sentence naming who is running it — not a crashed process.</p>
        </div>
        <div class="cell stat">
          <div class="n">Measured, <span class="dim">not guessed</span></div>
          <div class="cap">context pressure anchored on provider usage</div>
          <p>The built-in estimator prices Chinese prose at more than twice its
          real cost; the gate now trusts the number the provider reports.</p>
        </div>
        <div class="cell stat">
          <div class="n">Tools <span class="dim">survive resume</span></div>
          <div class="cap">model-visible means logged</div>
          <p>Every request must be rebuildable from the session file alone — a
          resumed agent can answer “what did you just run?”, and a test keeps
          it that way.</p>
        </div>
      </div>
      <p class="note rv">Compaction keeps the recent tail verbatim — assistant
      messages and tool results included — and replays correctly after resume.
      Each claim above ships with its regression test.</p>
    </div>
  </section>

  <section class="band" id="learns">
    <div class="in">
      <div class="head rv">
        <div>
          <span class="label">Skills · Memory · Goals</span>
          <h2>Local state <span class="dim">that compounds.</span></h2>
        </div>
        <p>What it keeps between conversations lives in your repository and
        your home directory, in formats other agents already read.</p>
      </div>
      <div class="defs rv">
        <div class="def">
          <h3>Skills</h3>
          <p>Progressive-disclosure playbooks in <code>.agents/skills/</code> —
          the open Agent-Skills format, so a skill written for Claude Code or
          Codex works here too.</p>
        </div>
        <div class="def">
          <h3>Memory &amp; instructions</h3>
          <p>Reads <code>AGENTS.md</code> from repo root to workspace and keeps
          durable notes under <code>.deepcode/memory/</code>, indexed and
          injected each session.</p>
        </div>
        <div class="def">
          <h3>Goals</h3>
          <p>Hand it an objective and a test command; the loop works, verifies
          against your tests, and reports — interruptible and resumable at any
          point.</p>
        </div>
        <div class="def">
          <h3>Evolve <span class="soon">in development</span></h3>
          <p>An opt-in loop that distills your own sessions into project
          skills — every learned skill carries provenance, passes a guardrail
          check, and reverts with one click.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="start">
    <div class="in qs-grid">
